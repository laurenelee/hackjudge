{
  "name": "hackjudge",
  "version": "0.1.0",
  "description": "Build every hackathon submission on its own fresh machine and record how far each one got. Judges read READMEs; this finds out whether the code builds.",
  "scripts": {
    "judge": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "fix": "tsx src/fix-cli.ts"
  },
  "keywords": [
    "hackathon",
    "judging",
    "sprites",
    "fly",
    "devrel",
    "sandbox",
    "build"
  ],
  "author": "Lauren Lee (https://github.com/laurenelee)",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fly/sprites": "^0.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laurenelee/hackjudge"
  },
  "engines": {
    "node": ">=20"
  }
}
